{
  "name": "android-toolkit",
  "version": "0.1.0",
  "description": "All-in-one Android firmware & maintenance toolkit",
  "author": "Gissa333",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc && npm run copy",
    "copy": "node -e \"const fs=require('fs');fs.cpSync('src/renderer','dist/renderer',{recursive:true})\"",
    "dist": "npm run build && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.androidtoolkit.app",
    "productName": "AndroidToolkit",
    "files": ["dist/**/*", "package.json"],
    "win": { "target": ["portable"] }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.4.0",
    "@types/node": "^20.0.0"
  }
}